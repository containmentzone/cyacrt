==> cyac.target <==
[Unit]
Description=cyac boxes and services

==> cybox@box-a.service <==
# Generated by cyac-generator from /var/lib/cyac/conf/box-a.cybox. Edit that file, not this one.

[Unit]
Description=cyac box box-a
SourcePath=/var/lib/cyac/conf/box-a.cybox
PartOf=cyac.target
BindsTo=cynetwork@dev.service
After=cynetwork@dev.service
Wants=cyservice@llm-proxy.service
After=cyservice@llm-proxy.service

[Service]
Type=simple
ExecStart=/bin/cyac run start cybox box-a
ExecStopPost=/bin/cyac run stop cybox box-a

==> cybox@lost.service <==
# Generated by cyac-generator from /var/lib/cyac/conf/lost.cybox. Edit that file, not this one.

[Unit]
Description=cyac box lost (invalid, see its status)
SourcePath=/var/lib/cyac/conf/lost.cybox
PartOf=cyac.target

[Service]
Type=oneshot
ExecStart=/bin/cyac-generator -check cybox lost

