ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryMax=256M
TasksMax=64

==> cygateway@out.service <==
# Generated by cyac-generator from /var/lib/cyac/conf/out.cygateway. Edit that file, not this one.

[Unit]
Description=cyac gateway out (direct)
SourcePath=/var/lib/cyac/conf/out.cygateway
PartOf=cyac.target
Wants=cydns@out.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/cyac run start cygateway out
ExecStop=/bin/cyac run stop cygateway out

