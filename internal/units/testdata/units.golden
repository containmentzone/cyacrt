==> cyservice@llm-proxy.service <==
# Generated by cyac-generator from /var/lib/cyac/conf/llm-proxy.cyservice. Edit that file, not this one.

[Unit]
Description=cyac service llm-proxy
SourcePath=/var/lib/cyac/conf/llm-proxy.cyservice
PartOf=cyac.target
BindsTo=cygateway@vpn.service cynetwork@dev.service
After=cygateway@vpn.service cynetwork@dev.service

[Service]
Type=simple
LoadCredential=OPENAI_API_KEY:/run/keys/openai
ExecStart=/bin/cyac run start cyservice llm-proxy
ExecStopPost=/bin/cyac run stop cyservice llm-proxy

