==> cygateway@out.service <==
# Generated by cyac-generator from /var/lib/cyac/conf/out.cygateway. Edit that file, not this one.

[Unit]
Description=cyac gateway out (direct)
SourcePath=/var/lib/cyac/conf/out.cygateway
PartOf=cyac.target
StopWhenUnneeded=yes

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/cyac run start cygateway out
ExecStop=/bin/cyac run stop cygateway out

