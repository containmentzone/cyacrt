==> cydns@dev.socket <==
# Generated by cyac-generator from /var/lib/cyac/conf/dev.cynetwork. Edit that file, not this one.

[Unit]
Description=cyac DNS for network dev
PartOf=cynetwork@dev.service
After=cynetwork@dev.service

[Socket]
ListenDatagram=10.42.1.2:53
ListenStream=10.42.1.2:53
FreeBind=yes

