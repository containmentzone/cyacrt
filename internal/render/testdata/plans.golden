==> cygateway out <==
up:
  ip netns add cygw-out
  ip -n cygw-out link set lo up
  ip netns exec cygw-out sysctl -q -w net.ipv4.ip_forward=1
  ip link add cygw0 type veth peer name uplink netns cygw-out
  ip addr add 10.42.254.0/31 dev cygw0
  ip link set cygw0 up
  ip -n cygw-out addr add 10.42.254.1/31 dev uplink
  ip -n cygw-out link set uplink up
  ip -n cygw-out route add default via 10.42.254.0
  sysctl -q -w net.ipv4.ip_forward=1
  nft -f -
    <<<
    table inet cygw-out
    delete table inet cygw-out
    table inet cygw-out {
    	chain input {
    		type filter hook input priority 0; policy accept;
    		iifname "cygw0" ct state established,related accept
    		iifname "cygw0" drop
    	}
    	chain forward {
    		type filter hook forward priority 0; policy accept;
    		iifname "cygw0" ip daddr 192.168.1.1 meta l4proto { tcp, udp } th dport 53 accept
    		iifname "cygw0" ip daddr { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 168.63.129.16, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4 } drop
    		iifname "cygw0" oifname != "eth0" drop
    		iifname "cygw0" accept
    		oifname "cygw0" ct state established,related accept
    	}
    	chain postrouting {
    		type nat hook postrouting priority 100;
    		ip saddr 10.42.254.1 oifname != "cygw0" masquerade
    	}
    }
    >>>
  ip netns exec cygw-out nft -f -
    <<<
    table inet gw {
    	chain input {
    		type filter hook input priority 0; policy drop;
    		iifname "lo" accept
    		ct state established,related accept
    	}
    	chain forward {
    		type filter hook forward priority 0; policy drop;
    		ct state established,related accept
    		oifname "uplink" ip daddr { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 168.63.129.16, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4 } drop
    		oifname "uplink" accept
    	}
    	chain postrouting {
    		type nat hook postrouting priority 100;
    		oifname "uplink" masquerade
    	}
    }
    >>>
down:
  nft delete table inet cygw-out
  ip link del cygw0
  ip netns del cygw-out

==> cygateway vpn <==
up:
  ip netns add cygw-vpn
  ip -n cygw-vpn link set lo up
  ip netns exec cygw-vpn sysctl -q -w net.ipv4.ip_forward=1
  ip link add cywg1 type wireguard
  ip link set cywg1 netns cygw-vpn
  ip -n cygw-vpn link set cywg1 name wg0
  ip netns exec cygw-vpn wg setconf wg0 /run/keys/wg0.conf
  ip -n cygw-vpn addr add 10.64.0.2/32 dev wg0
  ip -n cygw-vpn link set wg0 up
  ip -n cygw-vpn route add default dev wg0
  ip netns exec cygw-vpn nft -f -
    <<<
    table inet gw {
    	chain input {
    		type filter hook input priority 0; policy drop;
    		iifname "lo" accept
    		ct state established,related accept
    	}
    	chain forward {
    		type filter hook forward priority 0; policy drop;
    		ct state established,related accept
    		oifname "wg0" ip daddr { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 168.63.129.16, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4 } drop
    		oifname "wg0" accept
    	}
    	chain postrouting {
    		type nat hook postrouting priority 100;
    		oifname "wg0" masquerade
    	}
    }
    >>>
